# Build context for environment/Dockerfile (context = the repository root).
# Data are mounted at run time, never baked into the image.
data/
**/*.h5
**/*.hdf5
**/*.nc
**/*.nc4
**/*.zarr

# Not needed to run the pipeline
.git
.gitignore
figures/
notebooks/figures/

# Python, Jupyter and OS clutter
**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/
**/.pytest_cache/
**/*.egg-info/
**/.DS_Store
.venv/
.mypy_cache/
.ruff_cache/
